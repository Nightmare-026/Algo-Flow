"use client";

import { useState } from "react";
import { Eye, EyeOff } from "lucide-react";
import { Input, type InputProps } from "@/components/ui/input";

type PasswordFieldProps = Omit<InputProps, "type"> & {
  label: string;
  hint?: string;
};

export function PasswordField({ label, hint, id, className, ...props }: PasswordFieldProps) {
  const [visible, setVisible] = useState(false);
  const inputId = id ?? String(props.name);

  return (
    <div>
      <label htmlFor={inputId} className="text-sm font-semibold text-text-secondary">
        {label}
      </label>
      <div className="relative mt-2">
        <Input
          {...props}
          id={inputId}
          type={visible ? "text" : "password"}
          className={`pr-12 ${className ?? ""}`}
        />
        <button
          type="button"
          onClick={() => setVisible((current) => !current)}
          className="absolute inset-y-0 right-0 inline-flex w-11 items-center justify-center rounded-r-xl text-muted-foreground hover:text-primary-active"
          aria-label={visible ? `Hide ${label.toLowerCase()}` : `Show ${label.toLowerCase()}`}
          aria-pressed={visible}
        >
          {visible ? <EyeOff className="h-4 w-4" /> : <Eye className="h-4 w-4" />}
        </button>
      </div>
      {hint ? <p className="mt-2 text-xs leading-5 text-muted-foreground">{hint}</p> : null}
    </div>
  );
}
